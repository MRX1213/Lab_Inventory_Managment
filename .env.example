# SQL Server (required for API)
LAB_DB_SERVER=127.0.0.1
LAB_DB_PORT=14333
LAB_DB_NAME=LabInventory
LAB_DB_USER=sa
# Set in your environment only — never commit real passwords.
# This is the SQL Server login password (Mixed Mode / sa), NOT the web app login password.
LAB_DB_PASSWORD=

# Optional: HTTP port for same-origin API + static front-end (default 3000)
LAB_HTTP_PORT=3000
# Bind API to loopback only (default 127.0.0.1)
LAB_HTTP_BIND=127.0.0.1

# Optional: session secret (long random string)
LAB_SESSION_SECRET=

# Shared class APPLICATION login password (used after `npm run class:reset-accounts` — not auto-run).
# For this class project the instructor uses Panther$ for all active web accounts.
# In .env use single quotes so PowerShell/shell do not treat $ as a variable: LAB_CLASS_PASSWORD='Panther$'
# Never commit a real .env. Do not pass this password on the command line.
# LAB_CLASS_PASSWORD=

# One-time admin bootstrap (not stored in repo):
# LAB_ADMIN_EMAIL=admin@lab.example
# LAB_ADMIN_PASSWORD=  (set in shell, then run npm run bootstrap-admin)
# LAB_ADMIN_RECOVERY=1  (required to reset password for an existing admin email)